# Data directory — raw dumps and generated databases
# Use data/* (not data/) so git descends into subdirectories for exceptions below
data/*

# Data file types (belt-and-suspenders)
*.zst
*.sqlite
*.db
*.json

# Test fixtures — checked-in reference data, not generated output
!data/audit/
!data/audit/*.json

# Environment
.env
venv/
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# Project-specific docs (agent instructions, live plans)
CLAUDE.md
docs/ARCHITECTURE.md
docs/TODO.md
docs/archive/
docs/Intuitive Walk-through.md
