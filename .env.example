# Discord or Slack incoming webhook URL — required for surge alerts
# Leave unset to run in silent/no-op mode (backtest and local enrichment)
WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# Google Cloud Storage — defaults shown, override to use your own bucket
GCS_BUCKET=hn-surge-dashboard-01
GCS_PROJECT=your-gcp-project-id

# Kafka (Bluesky ingestion transport — Phase A/B, not yet live)
# BSKY_INPUT_MODE stays "jetstream" (direct WebSocket) until Phase F's cutover.
# In kafka mode, KAFKA_BOOTSTRAP_SERVERS is required or the process refuses to start.
BSKY_INPUT_MODE=jetstream
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC_BLUESKY_ROUTED=surge.bluesky.routed.v1
KAFKA_BSKY_ANOMALY_GROUP_ID=surge-bluesky-anomaly-v1
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
